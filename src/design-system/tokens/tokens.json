      "xl": {
        "$value": 1.25,
        "$type": "lineHeight"
      },
      "hero": {
        "$value": 1.1,
        "$type": "lineHeight"
      }
    },
    "letterSpacing": {
      "default": {
        "$value": 0,
        "$type": "letterSpacing"
      }
    }
  },
  "spacing": {
    "xs": {
      "$value": "clamp(0.25rem, 0.4vw, 0.5rem)",
