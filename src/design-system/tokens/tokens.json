        "$value": "\"Nunito\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "$type": "fontFamily"
      }
    },
    "size": {
      "font-size-xs": {
        "$value": "clamp(0.7rem, 0.85vw, 0.8rem)",
