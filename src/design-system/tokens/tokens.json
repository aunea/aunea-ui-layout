  "radius": {
    "none": {
      "$value": "0",
      "$type": "borderRadius"
    },
    "sm": {
      "$value": "8px",
      "$type": "borderRadius"
    },
    "lg": {
      "$value": "32px",
      "$type": "borderRadius"
    },
    "pill": {
      "$value": "9999px",
      "$type": "borderRadius"
    },
    "full": {
      "$value": "50%",
      "$type": "borderRadius"
    }
  },
  "shadow": {
    "light": {
      "subtle": {
        "$value": "0 1px 4px rgba(60, 50, 40, 0.08)",
        "$type": "boxShadow"
      },
      "medium": {
        "$value": "0 6px 18px rgba(60, 50, 40, 0.12)",
        "$type": "boxShadow"
      },
      "heavy": {
        "$value": "0 14px 36px rgba(60, 50, 40, 0.18)",
        "$type": "boxShadow"
      }
    },
    "dark": {
      "subtle": {
        "$value": "0 1px 4px rgba(255, 255, 255, 0.08)",
        "$type": "boxShadow"
      },
      "medium": {
        "$value": "0 6px 20px rgba(255, 255, 255, 0.14)",
        "$type": "boxShadow"
      },
      "heavy": {
        "$value": "0 14px 40px rgba(255, 255, 255, 0.22)",
        "$type": "boxShadow"
      }
    }
  },
  "button": {
    "size": {
      "button-size-icon": {
        "$value": "clamp(28px, 3vw, 36px)",
        "$type": "dimension"
      },
      "button-size-sm": {
        "$value": "clamp(36px, 4vw, 44px)",
        "$type": "dimension"
      },
      "button-size-md": {
        "$value": "clamp(44px, 5vw, 56px)",
        "$type": "dimension"
      },
      "button-size-lg": {
        "$value": "clamp(56px, 6vw, 72px)",
        "$type": "dimension"
      },
      "button-size-hero": {
        "$value": "clamp(72px, 9vw, 120px)",
        "$type": "dimension"
      }
    }
  },
  "motion": {
    "duration": {
      "motion-duration-fast": {
        "$value": "200ms",
        "$type": "duration"
      },
      "motion-duration-medium": {
        "$value": "800ms",
        "$type": "duration"
      },
      "motion-duration-slow": {
        "$value": "1600ms",
        "$type": "duration"
      }
    },
    "easing": {
      "motion-easing-standard": {
        "$value": "cubic-bezier(0.2, 1, 0.3, 1)",
        "$type": "cubicBezier"
      }
    }
  }
