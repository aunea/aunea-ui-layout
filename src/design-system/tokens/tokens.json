{
  "color": {
    "background": {
      "light": {
        "$value": "#EDE6D8",
        "$type": "color"
      },
      "dark": {
        "$value": "#000000",
        "$type": "color"
      }
    },
    "surface": {
      "primary": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "secondary": {
        "$value": "#111111",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$type": "color"
      }
    },
    "text": {
      "primary-light": {
        "$value": "#EDE6D8",
        "$type": "color"
      },
      "primary-dark": {
        "$value": "#000000",
        "$type": "color"
      },
      "secondary": {
        "$value": "#6B6B6B",
        "$type": "color"
      },
      "muted": {
        "$value": "#9A9A9A",
        "$type": "color"
      },
      "disabled": {
        "$value": "#8A9199",
        "$type": "color"
      }
    },
    "status": {
      "success": {
        "$value": "#3EE6C1",
        "$type": "color"
      },
      "warning": {
        "$value": "#F2C46D",
        "$type": "color"
      },
      "danger": {
        "$value": "#8C2F2F",
        "$type": "color"
      },
      "processing": {
        "$value": "#3A6EFF",
        "$type": "color"
      }
    },
    "gradient": {
      "allState": {
        "colors": {
          "success": {
            "$value": "{color.status.success}"
          },
          "warning": {
            "$value": "{color.status.warning}"
          },
          "danger": {
            "$value": "{color.status.danger}"
          },
          "processing": {
            "$value": "{color.status.processing}"
          }
        }
      }
    },
    "color": {
      "gray": {
        "50": {
          "$value": "#F2F3F4",
          "$type": "color"
        },
        "100": {
          "$value": "#E3E5E7",
          "$type": "color"
        },
        "200": {
          "$value": "#C9CDD2",
          "$type": "color"
        },
        "300": {
          "$value": "#AEB4BB",
          "$type": "color"
        },
        "400": {
          "$value": "#8A9199",
          "$type": "color"
        },
        "500": {
          "$value": "#6F767E",
          "$type": "color"
        },
        "600": {
          "$value": "#565C63",
          "$type": "color"
        },
        "700": {
          "$value": "#3E4348",
          "$type": "color"
        },
        "800": {
          "$value": "#26292D",
          "$type": "color"
        },
        "900": {
          "$value": "#111111",
          "$type": "color"
        }
      }
    },
    "border": {
      "subtle": {
        "$value": "rgba(0, 0, 0, 0.08)",
        "$type": "color"
      },
      "default": {
        "$value": "rgba(0, 0, 0, 0.15)",
        "$type": "color"
      }
    }
  },
  "font": {
    "family": {
      "base": {
        "$value": "Inter, system-ui, sans-serif",
        "$type": "fontFamily"
      }
    },
    "size": {
      "xs": {
        "$value": "0.75rem",
        "$type": "fontSize"
      },
      "sm": {
        "$value": "0.875rem",
        "$type": "fontSize"
      },
      "md": {
        "$value": "1rem",
        "$type": "fontSize"
      },
      "lg": {
        "$value": "1.125rem",
        "$type": "fontSize"
      },
      "xl": {
        "$value": "1.5rem",
        "$type": "fontSize"
      }
    },
    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      }
    },
    "lineHeight": {
      "default": {
        "$value": "1.5",
        "$type": "number"
      },
      "tight": {
        "$value": "1.2",
        "$type": "number"
      }
    }
  },
  "spacing": {
    "stack": {
      "xs": {
        "$value": "0.25rem",
        "$type": "dimension"
      },
      "sm": {
        "$value": "0.5rem",
        "$type": "dimension"
      },
      "md": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "lg": {
        "$value": "1.5rem",
        "$type": "dimension"
      },
      "xl": {
        "$value": "2rem",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "4rem",
        "$type": "dimension"
      }
    },
    "inline": {
      "xs": {
        "$value": "0.25rem",
        "$type": "dimension"
      },
      "sm": {
        "$value": "0.5rem",
        "$type": "dimension"
      },
      "md": {
        "$value": "0.75rem",
        "$type": "dimension"
      },
      "lg": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "xl": {
        "$value": "1.5rem",
        "$type": "dimension"
      }
    }
  },
  "radius": {
    "xs": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "sm": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "round": {
      "$value": "999px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "light": {
      "subtle": {
        "$value": "0 2px 6px rgba(0, 0, 0, 0.08)",
        "$type": "boxShadow"
      },
      "default": {
        "$value": "0 6px 18px rgba(0, 0, 0, 0.12)",
        "$type": "boxShadow"
      },
      "hover": {
        "$value": "0 8px 22px rgba(0, 0, 0, 0.16)",
        "$type": "boxShadow"
      }
    },
    "dark": {
      "subtle": {
        "$value": "0 2px 4px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.06)",
        "$type": "boxShadow"
      },
      "default": {
        "$value": "0 6px 12px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 255, 255, 0.08)",
        "$type": "boxShadow"
      },
      "hover": {
        "$value": "0 10px 20px rgba(0, 0, 0, 0.98), 0 0 0 1px rgba(255, 255, 255, 0.12)",
        "$type": "boxShadow"
      }
    }
  },
  "button": {
    "height": {
      "sm": {
        "$value": "2.25rem",
        "$type": "dimension"
      },
      "md": {
        "$value": "3rem",
        "$type": "dimension"
      },
      "lg": {
        "$value": "4rem",
        "$type": "dimension"
      },
      "xl": {
        "$value": "5rem",
        "$type": "dimension"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$value": "200ms",
        "$type": "duration"
      },
      "medium": {
        "$value": "800ms",
        "$type": "duration"
      },
      "slow": {
        "$value": "1600ms",
        "$type": "duration"
      }
    },
    "easing": {
      "standard": {
        "$value": "cubic-bezier(0.2, 1, 0.3, 1)",
        "$type": "cubicBezier"
      }
    }
  }
}
