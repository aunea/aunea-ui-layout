{
  "color": {
    "background": {
      "light": {
        "$value": "#EDE6D8",
        "$type": "color"
      },
      "dark": {
        "$value": "#000000",
        "$type": "color"
      }
    },

    "surface": {
      "primary": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "secondary": {
        "$value": "#111111",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$type": "color"
      }
    },

    "text": {
      "primary": {
        "$value": "#000000",
        "$type": "color"
      },
      "secondary": {
        "$value": "#6B6B6B",
        "$type": "color"
      },
      "muted": {
        "$value": "#9A9A9A",
        "$type": "color"
      },
      "inverse": {
        "$value": "#EDE6D8",
        "$type": "color"
      },
      "disabled": {
        "$value": "#8A9199",
        "$type": "color"
      }
    },

    "status": {
      "success": {
        "$value": "#3EE6C1",
        "$type": "color"
      },
      "warning": {
        "$value": "#F2C46D",
        "$type": "color"
      },
      "danger": {
        "$value": "#8C2F2F",
        "$type": "color"
      },
      "processing": {
        "$value": "#3A6EFF",
        "$type": "color"
      }
    },

    "border": {
      "subtle": {
        "$value": "rgba(0, 0, 0, 0.08)",
        "$type": "color"
      },
      "default": {
        "$value": "rgba(0, 0, 0, 0.15)",
        "$type": "color"
      }
    }
  },

  "font": {
    "family": {
      "base": {
        "$value": "Inter, system-ui, sans-serif",
        "$type": "fontFamily"
      }
    },

    "size": {
      "xs": {
        "$value": "12px",
        "$type": "fontSize"
      },
      "sm": {
        "$value": "14px",
        "$type": "fontSize"
      },
      "md": {
        "$value": "16px",
        "$type": "fontSize"
      },
      "lg": {
        "$value": "18px",
        "$type": "fontSize"
      },
      "xl": {
        "$value": "24px",
        "$type": "fontSize"
      }
    },

    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      }
    },

    "lineHeight": {
      "default": {
        "$value": "1.5",
        "$type": "number"
      },
      "tight": {
        "$value": "1.2",
        "$type": "number"
      }
    }
  },

  "spacing": {
    "stack": {
      "xs": {
        "$value": "4px",
        "$type": "dimension"
      },
      "sm": {
        "$value": "8px",
        "$type": "dimension"
      },
      "md": {
        "$value": "16px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "24px",
        "$type": "dimension"
      },
      "xl": {
        "$value": "32px",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "64px",
        "$type": "dimension"
      }
    },

    "inline": {
      "xs": {
        "$value": "4px",
        "$type": "dimension"
      },
      "sm": {
        "$value": "8px",
        "$type": "dimension"
      },
      "md": {
        "$value": "12px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "16px",
        "$type": "dimension"
      }
    }
  },

  "radius": {
    "xs": {
      "$value": "4px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension"
    },
    "round": {
      "$value": "999px",
      "$type": "dimension"
    }
  },

  "shadow": {
    "subtle": {
      "$value": "0 2px 6px rgba(0, 0, 0, 0.08)",
      "$type": "boxShadow"
    },
    "default": {
      "$value": "0 6px 18px rgba(0, 0, 0, 0.12)",
      "$type": "boxShadow"
    },
    "hover": {
      "$value": "0 8px 22px rgba(0, 0, 0, 0.16)",
      "$type": "boxShadow"
    }
  },

  "button": {
    "height": {
      "sm": {
        "$value": "36px",
        "$type": "dimension"
      },
      "md": {
        "$value": "48px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "64px",
        "$type": "dimension"
      }
    }
  },

  "motion": {
    "duration": {
      "fast": {
        "$value": "150ms",
        "$type": "duration"
      },
      "medium": {
        "$value": "300ms",
        "$type": "duration"
      },
      "slow": {
        "$value": "700ms",
        "$type": "duration"
      }
    },

    "easing": {
      "standard": {
        "$value": "cubic-bezier(0.2, 1, 0.3, 1)",
        "$type": "cubicBezier"
      }
    }
  }
}
