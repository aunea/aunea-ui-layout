    "lg": {
      "$value": "clamp(1.25rem, 2vw, 2rem)",
      "$type": "spacing"
    },
    "xl": {
      "$value": "clamp(2rem, 3vw, 3rem)",
      "$type": "spacing"
    },
    "2xl": {
      "$value": "clamp(3rem, 4vw, 4.5rem)",
      "$type": "spacing"
    },
    "3xl": {
      "$value": "clamp(4rem, 6vw, 6rem)",
      "$type": "spacing"
    }
