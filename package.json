{
  "name": "@aunea/ui-layout",
  "version": "0.1.3",
  "description": "AUNE-A design system: tokens and base styles",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rimraf": "^6.1.2",
    "semantic-release": "^24.2.9",
    "style-dictionary": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:tokens": "node src/design-system/build/build-tokens.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run clean && npm run build:tokens && npm run build:ts && npm run build:css"
  }
}
