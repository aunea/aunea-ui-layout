{
  "name": "@aunea/ui-layout",
  "version": "0.1.19",
  "description": "AUNE-A design system: tokens and base styles",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./styles.css": "./dist/index.css"
  },
  "sideEffects": [
    "dist/index.css"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^19",
    "react-dom": "^19",
    "rimraf": "^6.1.2",
    "storybook": "^10.1.11",
    "style-dictionary": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:tokens": "node src/design-system/build/build-tokens.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run clean && npm run build:tokens && npm run build:ts && npm run build:css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  }
}
