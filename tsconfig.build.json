{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "include": ["src/components"],
  "exclude": [
    "**/*.stories.ts",
    "**/*.stories.tsx",
    ".storybook",
    "src/stories"
  ]
}